+/*
+ * Landing page (Figma "Landing", Nov 2026 redesign).
+ *
+ * A plain page in the shared tokens (redesign.css): copy on the left, the climb
+ * on a navy hero panel on the right, three feature cards and a navy closing
+ * band. Imported by LandingPage only, so these rules load after the shared
+ * sheets and win their ties.
+ */
+
 .landing-page {
   min-height: 100vh;
-  overflow-x: hidden;
-  background:
-    radial-gradient(circle at 82% 12%, rgba(12, 130, 200, 0.08), transparent 24rem),
-    #f7f9fc;
-  color: #0a3a58;
+  background: var(--bg);
+  color: var(--text);
 }
 
-.landing-header {
-  width: min(1180px, calc(100% - 32px));
-  min-height: 86px;
-  margin: 0 auto;
+.landing-page > main {
   display: flex;
-  align-items: center;
-  justify-content: space-between;
-  gap: 18px;
+  flex-direction: column;
+  gap: 64px;
+  width: min(var(--page-width), calc(100% - 32px));
+  margin: 0 auto;
+  padding: 32px 0 48px;
 }
 
-.landing-header .wordmark-text {
-  color: #0a3a58;
-}
+/* ------------------------------------------------------------------ header */
 
-/*
- * The language and theme, then Log In and Sign Up. On a narrow phone the group
- * wraps onto two rows, at the right, rather than pushing the page sideways.
- */
-.landing-actions {
+.landing-header {
   display: flex;
   align-items: center;
-  justify-content: flex-end;
-  flex-wrap: wrap;
-  gap: 10px;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 16px max(16px, calc((100% - var(--page-width)) / 2));
+  border-bottom: 1px solid var(--border);
+  background: var(--surface);
 }
 
-.landing-controls {
-  display: flex;
-  align-items: center;
-  gap: 6px;
+.landing-header .wordmark-text {
+  color: var(--brand-strong);
+  font-size: 1.35rem;
+  font-weight: 600;
 }
 
+.landing-actions,
+.landing-controls,
 .landing-nav {
   display: flex;
   align-items: center;
-  gap: 10px;
-}
-
-.landing-nav button {
-  min-height: 44px;
-  padding: 0 19px;
-  border-radius: 999px;
-  font: inherit;
-  font-size: 14px;
-  font-weight: 750;
-  /* "Create account" broke over two lines on a 320px phone. */
-  white-space: nowrap;
-  cursor: pointer;
-  transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
-}
-
-.landing-login {
-  border: 1px solid #d8e6f0;
-  background: #ffffff;
-  color: #0a3a58;
-  box-shadow: 0 6px 18px rgba(10, 58, 88, 0.06);
+  gap: 8px;
 }
 
-/*
- * The words and fills here use #0a70ad, a step darker than the logo's
- * #0c82c8: white on the logo blue, and the logo blue on white or its pale
- * tints, only reach 3.5-4.2:1, under the 4.5:1 small text needs. The logo
- * blue stays in the artwork and the hero circle, which carry no small text.
- */
-.landing-signup {
-  border: 1px solid #0a70ad;
-  background: #0a70ad;
-  color: #ffffff;
-  box-shadow: 0 7px 18px rgba(12, 130, 200, 0.2);
-}
-
-.landing-nav button:hover {
-  transform: translateY(-2px);
+.landing-actions {
+  gap: 16px;
 }
 
-/* ---------------------------------------------------------------- hero */
+/* -------------------------------------------------------------------- hero */
 
 .landing-hero {
-  width: min(1180px, calc(100% - 32px));
-  margin: 18px auto 24px;
   display: grid;
-  grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
-  gap: 22px;
-  align-items: stretch;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
+  gap: 64px;
+  align-items: center;
 }
 
-.landing-left,
-.landing-right {
-  min-width: 0;
-  border-radius: 32px;
+.landing-left {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 24px;
 }
 
-.landing-left {
-  position: relative;
-  overflow: hidden;
-  padding: clamp(30px, 5vw, 54px);
-  /*
-   * Dark enough behind the small white text to clear 4.5:1 everywhere, the
-   * glow included. On a phone the label and the first lines of the intro run
-   * the whole width, under the glow, and with the old start (#0b78bd) and a
-   * stronger glow they fell to 3.8:1. The start is now the text blue the
-   * buttons use, and the glow is lighter.
-   */
-  background:
