+  font-weight: 700;
+  letter-spacing: 0.1em;
 }
 
 .landing-left h1 {
   margin: 0;
-  max-width: 650px;
-  color: #ffffff;
-  font-size: clamp(52px, 6vw, 84px);
-  font-weight: 850;
-  line-height: 0.93;
-  letter-spacing: -0.055em;
-}
-
-/*
- * Russian and Azerbaijani put one long word on a line ("ДОСТИГНИТЕ",
