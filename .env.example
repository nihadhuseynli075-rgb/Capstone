# Copy this file to .env and fill in the values.
# .env is gitignored, so credentials never end up in the repository.

# ---------------------------------------------------------------- Supabase
# From the Supabase dashboard: Project settings -> API keys.
# The URL and publishable key are used by the browser for signing in (the
# publishable key is public by design). The secret key is the API's alone and
# never reaches the browser. Without it the API still runs, but questions and
# results are held in memory only and are lost whenever it restarts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_IMAGE_BUCKET=question-images
# Profile photos. Migration 0007 creates this bucket.
SUPABASE_AVATAR_BUCKET=avatars

# ------------------------------------------------------------------- Admin
# Password for the admin dashboard at /#/admin.
# Leave blank in development to use the built-in default, "capstone123". Blank
# means the default, never an empty password: an empty box never signs anyone in.
# That default is written in this file and in the source, so anyone who can see
# the repository knows it: with NODE_ENV=production a blank value keeps the
# dashboard shut until a real password is set here. Everything students use
# runs either way.
ADMIN_PASSWORD=

# -------------------------------------------------------------- AI marking
# Marks written (open-ended) answers, acting as a Grade 9 teacher against each
# question's marking guide. From https://console.anthropic.com -> API keys.
# Leave blank and written questions are simply left out of tests.
# Each written answer marked costs roughly one to three US cents.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------- API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Proxies in front of the API once it is hosted (1 on most hosts). Starting
# tests and admin sign-in are limited per address, and behind a proxy every
# request looks like it comes from the proxy until this is set. Leave it at 0
# when nothing sits in front of the API: a proxy that is not there would let
# anyone pick their own address.
TRUST_PROXY=0

# --------------------------------------------------------------- Web app
# Where the browser finds the API. SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY
# above reach the browser too; nothing else in this file does (see
# apps/web/vite.config.ts).
VITE_API_BASE_URL=http://localhost:4000
