# Copy this file to .env and fill in the values.
# .env is gitignored, so credentials never end up in the repository.

# ---------------------------------------------------------------- Supabase
# From the Supabase dashboard: Project settings -> API.
# Without these the API still runs, but questions and results are held in
# memory only and are lost whenever it restarts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=question-images

# ------------------------------------------------------------------- Admin
# Password for the admin dashboard at /#/admin.
# Leave blank in development to use the built-in default, but set a real one
# before the site is reachable by anyone else.
ADMIN_PASSWORD=

# --------------------------------------------------------------------- API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# --------------------------------------------------------------- Web app
# Only variables prefixed with VITE_ are exposed to the browser.
# Never put the service role key here.
VITE_API_BASE_URL=http://localhost:4000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
